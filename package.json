{
  "name": "vite_template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run clean && vite",
    "clean": "node -e \"const fs = require('node:fs'); ['dist', 'tsconfig.tsbuildinfo', 'tsconfig.app.tsbuildinfo', 'tsconfig.node.tsbuildinfo'].forEach((path) => fs.rmSync(path, { recursive: true, force: true }))\"",
    "prebuild": "npm run clean",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=1024 tsc -b && vite build",
    "lint": "npm run clean && eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.12.0",
    "axios": "1.18.1",
    "clsx": "2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-redux": "9.3.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "redux-types": "2.0.3",
    "sass": "^1.101.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4"
  }
}
